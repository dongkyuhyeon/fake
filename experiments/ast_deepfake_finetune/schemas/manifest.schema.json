{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment 002 audio manifest row",
  "type": "object",
  "required": [
    "sample_id", "split", "audio_path", "source_type", "file_fake",
    "voice_present", "music_present", "voice_fake", "music_fake",
    "voice_fake_mask", "music_fake_mask", "source_sha256", "license_review"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "audio_path": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["real", "generated", "mixture", "partial_fake", "hard_negative"]},
    "file_fake": {"type": "integer", "minimum": 0, "maximum": 1},
    "voice_present": {"type": "integer", "minimum": 0, "maximum": 1},
    "music_present": {"type": "integer", "minimum": 0, "maximum": 1},
    "voice_fake": {"type": "integer", "minimum": 0, "maximum": 1},
    "music_fake": {"type": "integer", "minimum": 0, "maximum": 1},
    "voice_fake_mask": {"type": "integer", "minimum": 0, "maximum": 1},
    "music_fake_mask": {"type": "integer", "minimum": 0, "maximum": 1},
    "voice_source_id": {"type": ["string", "null"]},
    "music_source_id": {"type": ["string", "null"]},
    "speaker_id": {"type": ["string", "null"]},
    "artist_id": {"type": ["string", "null"]},
    "track_id": {"type": ["string", "null"]},
    "voice_generator": {"type": ["string", "null"]},
    "music_generator": {"type": ["string", "null"]},
    "generator_revision": {"type": ["string", "null"]},
    "prompt_or_text_sha256": {"type": ["string", "null"]},
    "seed": {"type": ["integer", "null"]},
    "voice_gain_db": {"type": ["number", "null"]},
    "music_gain_db": {"type": ["number", "null"]},
    "codec": {"type": ["string", "null"]},
    "channel": {"type": ["string", "null"]},
    "sample_rate": {"const": 16000},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "source_url": {"type": ["string", "null"]},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "license_id": {"type": "string", "minLength": 1},
    "license_review": {"enum": ["pending", "approved", "rejected"]}
  },
  "additionalProperties": true
}
